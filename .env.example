# Copy this file to .env.local and fill in your key.
# Variable names are case-sensitive: keep them in capitals, exactly as written here.

# Required for briefs. Create one at https://platform.claude.com (API keys).
# Scanning stores works without it; writing a brief needs it.
ANTHROPIC_API_KEY=

# Optional. Any Claude model ID. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. low is fastest and cheapest, high is most thorough. Defaults to medium.
# ANTHROPIC_EFFORT=medium

# Optional but recommended before you share a public link:
# visitors must enter this code before the app scans a site or calls Claude on your key.
# DEMO_ACCESS_CODE=

# Optional. Override cost estimates (USD per million tokens) if you switch models.
# PRICE_INPUT_PER_MTOK=2
# PRICE_OUTPUT_PER_MTOK=10
